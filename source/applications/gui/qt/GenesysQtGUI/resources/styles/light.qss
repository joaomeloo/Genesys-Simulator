/* Light Theme for GenESyS Simulator */

/* Main Window */
QMainWindow {
    background-color: #f0f0f0;
}

QWidget:disabled {
    color: #808080;
}

QMenu::item:disabled {
    color: #808080;
}

QToolButton:disabled {
    color: #808080;
}

/* Menus */
QMenuBar {
    background-color: #ffffff;
    color: #000000;
}

QMenuBar::item:selected {
    background-color: #e0e0e0;
}

QMenu {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
}

QMenu::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}

/* Toolbars */
QToolBar {
    background-color: #f0f0f0;
    border: 1px solid #c0c0c0;
    spacing: 3px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px;
}

QToolButton:hover {
    background-color: #e0e0e0;
    border: 1px solid #c0c0c0;
}

QToolButton:pressed {
    background-color: #c0c0c0;
}

/* Dock Widgets */
QDockWidget {
    background-color: #f0f0f0;
    color: #000000;
    titlebar-close-icon: url(:/icons3/resources/icons/pack3/ico/cancel.ico);
}

QDockWidget::title {
    background-color: #e0e0e0;
    padding: 5px;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #c0c0c0;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #000000;
    border: 1px solid #c0c0c0;
    padding: 5px 10px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
}

QTabBar::tab:hover {
    background-color: #d0d0d0;
}

/* Tree Widgets */
QTreeWidget, QTreeView {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
    alternate-background-color: #f5f5f5;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #e0e0e0;
}

/* Table Widgets */
QTableWidget, QTableView {
    background-color: #ffffff;
    color: #000000;
    gridline-color: #c0c0c0;
    border: 1px solid #c0c0c0;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #e0e0e0;
    color: #000000;
    padding: 4px;
    border: 1px solid #c0c0c0;
}

/* Text Edits and Plain Text Edits */
QTextEdit, QPlainTextEdit, QLineEdit {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 16px;
    border: 1px solid #c0c0c0;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar:horizontal {
    background-color: #f0f0f0;
    height: 16px;
    border: 1px solid #c0c0c0;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

/* Push Buttons */
QPushButton {
    background-color: #e0e0e0;
    color: #000000;
    border: 1px solid #c0c0c0;
    padding: 5px 15px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:pressed {
    background-color: #c0c0c0;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #808080;
}

/* Status Bar */
QStatusBar {
    background-color: #f0f0f0;
    color: #000000;
}

/* Graphics View */
QGraphicsView {
    background-color: #ffffff;
    border: 2px solid #c0c0c0;
}

/* Splitter */
QSplitter::handle {
    background-color: #c0c0c0;
}

QSplitter::handle:hover {
    background-color: #a0a0a0;
}

/* Combo Box */
QComboBox {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
    padding: 3px;
}

QComboBox:hover {
    border: 1px solid #0078d7;
}

QComboBox::drop-down {
    border-left: 1px solid #c0c0c0;
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #c0c0c0;
}

/* Check Box and Radio Button */
QCheckBox, QRadioButton {
    color: #000000;
}

/* Group Box */
QGroupBox {
    color: #000000;
    border: 1px solid #c0c0c0;
    margin-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

/* Labels */
QLabel {
    color: #000000;
}
